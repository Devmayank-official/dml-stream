# =============================================================================
# DML Stream - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Default output folder for downloads
# Windows: D:\Downloads\dml-stream
# macOS: ~/Downloads/dml-stream
# Linux: ~/Downloads/dml-stream
DML_STREAM_DEFAULT_OUTPUT_FOLDER=downloads

# Download method: 'normal' or 'fast'
DML_STREAM_DEFAULT_METHOD=normal

# Number of download threads (1-12)
DML_STREAM_DEFAULT_THREADS=4

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DML_STREAM_LOG_LEVEL=INFO

# Log file path (relative to config directory)
DML_STREAM_LOG_FILE_PATH=logs/app.log.json

# Maximum log file size in bytes (default: 10MB)
DML_STREAM_LOG_MAX_BYTES=10485760

# Number of backup log files to keep
DML_STREAM_LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable/disable scheduled downloads
DML_STREAM_ENABLE_SCHEDULED_DOWNLOADS=true

# Enable/disable batch downloads
DML_STREAM_ENABLE_BATCH_DOWNLOADS=true

# Enable/disable process tracking
DML_STREAM_ENABLE_PROCESS_TRACKING=true

# Enable/disable download history
DML_STREAM_ENABLE_DOWNLOAD_HISTORY=true

# Enable rich console output
DML_STREAM_ENABLE_RICH_CONSOLE=true

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# HTTP request timeout in seconds
DML_STREAM_REQUEST_TIMEOUT=30

# Maximum retry attempts for failed requests
DML_STREAM_MAX_RETRIES=3

# Delay between retries in seconds
DML_STREAM_RETRY_DELAY=5

# -----------------------------------------------------------------------------
# UI Configuration
# -----------------------------------------------------------------------------

# Color theme: 'default' or 'dark'
DML_STREAM_COLOR_THEME=default

# -----------------------------------------------------------------------------
# File Paths (Advanced)
# -----------------------------------------------------------------------------

# Configuration file path
# DML_STREAM_CONFIG_FILE_PATH=config.json

# History file path
# DML_STREAM_HISTORY_FILE_PATH=download_history.json

# Scheduled downloads file path
# DML_STREAM_SCHEDULED_DOWNLOADS_FILE_PATH=scheduled_downloads.json

# Batch downloads file path
# DML_STREAM_BATCH_DOWNLOADS_FILE_PATH=batch_downloads.json

# -----------------------------------------------------------------------------
# Docker-Specific Settings (Optional)
# -----------------------------------------------------------------------------

# Timezone for containers
# TZ=America/New_York

# User ID for container (Linux only)
# PUID=1000

# Group ID for container (Linux only)
# PGID=1000

# -----------------------------------------------------------------------------
# Development Settings (Optional)
# -----------------------------------------------------------------------------

# Enable debug mode
# DML_STREAM_DEBUG=true

# Python breakpoint (for debugging)
# PYTHONBREAKPOINT=pdb.set_trace

# Disable bytecode generation
# PYTHONDONTWRITEBYTECODE=1

# Unbuffered Python output
# PYTHONUNBUFFERED=1
